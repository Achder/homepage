---
import Slider from '../components/Slider.astro'
import Input from '../components/Input.astro'
import Playground from '../layouts/Playground.astro'
import ControlSection from '../components/ControlSection.astro'
---

<Playground
    pageTitle="Grid Generator | Thomas Meerpohl"
    pageDescription="Experimental SVG grid generator that warps line grids with fractal noise, with gradient colors and SVG export."
    heading="Grid"
    robots="noindex,follow"
    colorspace={false}
    softproof={false}
>
    <Fragment slot="controls">
        <ControlSection>
            <Slider id="noise-freq" min={0.1} max={3} value={0.78821} step={0.00001} reset={0.001} name="Noise Freq" />
            <Slider id="time" min={0.001} max={2} value={0.8924} step={0.0001} reset={0.001} name="Time" />
            <Slider id="scale" min={0.1} max={2} value={0.59} step={0.01} reset={1} name="Scale" />
            <Slider id="octaves" min={1} max={16} value={13} step={1} reset={1} name="Octaves" />
            <Slider id="lacunarity" min={0.1} max={5} value={2.231} step={0.001} reset={1} name="Lacunarity" />
            <Slider id="gain" min={0} max={1} value={0.357} step={0.001} reset={0.5} name="Gain" />
        </ControlSection>

        <ControlSection class="grid-cols-2">
            <Slider id="x-offset" min={-1} max={1} value={0} reset={0} step={0.001} name="x - Offset" />
            <Slider id="y-offset" min={-1} max={1} value={0} reset={0} step={0.001} name="y - Offset" />
            <Slider id="x-shapes" min={1} max={500} value={135} reset={20} name="x - Shapes" />
            <Slider id="y-shapes" min={1} max={500} value={371} reset={20} name="y - Shapes" />
            <Slider id="x-amp" min={-1} max={1} value={0.848} reset={1} step={0.001} name="x - Amp" />
            <Slider id="y-amp" min={-1} max={1} value={0.698} reset={1} step={0.001} name="y - Amp" />
        </ControlSection>

        <ControlSection class="grid-cols-2">
            <Slider id="x-stroke-width" min={0} max={1} step={0.001} value={0.159} name="x - Stroke Width" />
            <Slider id="y-stroke-width" min={0} max={1} step={0.001} value={0} name="y - Stroke Width" />
        </ControlSection>

        <ControlSection class="grid-cols-2">
            <Slider id="grid-angle" min={0} max={360} value={271} name="Grid Angle" class="col-span-2" />
            <Input type="color" id="grid-start" label="Grid Start" value="#a6ff00" />
            <Input type="color" id="grid-end" label="Grid End" value="#00ffe1" />
        </ControlSection>

        <ControlSection class="grid-cols-2">
            <Slider id="bg-angle" min={0} max={360} value={132} name="Bg Angle" class="col-span-2" />
            <Input type="color" id="bg-start" label="Background Start" value="#3d0000" />
            <Input type="color" id="bg-end" label="Background End" value="#1b0029" />
        </ControlSection>
    </Fragment>
</Playground>
<script>
    import type Color from 'colorjs.io'
    import { initPlayground } from '../vector/playground'
    import { gradientLine } from '../vector/paint'
    import type { LinearGradient, Size } from '../vector/types'
    import { computeDisplacement, type GridNoise } from '../utils/grid-field'
    import type { GridWorkerRequest, GridWorkerResponse } from '../workers/grid-worker'

    // #region field
    // The noise is the slow part, so it runs on a pool of workers, each one computing
    // a band of rows. The live view draws the latest finished field; while a job runs,
    // only the newest request waits.
    type Field = { key: string; noise: GridNoise; displacement: Float32Array }
    type Job = Field & { id: number; remaining: number }

    const workers = Array.from(
        { length: Math.max(1, Math.min(8, (navigator.hardwareConcurrency || 4) - 1)) },
        () => new Worker(new URL('../workers/grid-worker.ts', import.meta.url), { type: 'module' })
    )

    let current: Field | null = null
    let running: Job | null = null
    let pending: { key: string; noise: GridNoise } | null = null
    let jobId = 0
    let onField = () => {}

    function startJob(key: string, noise: GridNoise) {
        const job: Job = {
            id: ++jobId,
            key,
            noise,
            displacement: new Float32Array(noise.xShapes * noise.yShapes * 2),
            remaining: workers.length,
        }
        running = job

        const rowsPerWorker = Math.ceil(noise.yShapes / workers.length)
        workers.forEach((worker, idx) => {
            const rowStart = Math.min(idx * rowsPerWorker, noise.yShapes)
            const rowEnd = Math.min(rowStart + rowsPerWorker, noise.yShapes)
            const request: GridWorkerRequest = { job: job.id, noise, rowStart, rowEnd }
            worker.postMessage(request)
        })
    }

    for (const worker of workers) {
        worker.onmessage = (event: MessageEvent<GridWorkerResponse>) => {
            const { job, rowStart, displacement } = event.data
            if (!running || job !== running.id) {
                return
            }

            running.displacement.set(displacement, rowStart * running.noise.xShapes * 2)
            if (--running.remaining > 0) {
                return
            }

            current = running
            running = null
            if (pending) {
                startJob(pending.key, pending.noise)
                pending = null
            }
            onField()
        }
    }

    function getField(noise: GridNoise, sync: boolean) {
        const key = JSON.stringify(noise)
        if (current?.key === key) {
            return current
        }

        // the export can not wait for the workers
        if (sync) {
            current = { key, noise, displacement: computeDisplacement(noise, 0, noise.yShapes) }
            return current
        }

        if (!running) {
            startJob(key, noise)
        } else {
            pending = running.key === key ? null : { key, noise }
        }
        return current
    }
    // #endregion field

    function getSeed() {
        const searchParams = new URLSearchParams(window.location.search)
        const value = searchParams.get('seed')
        if (value) {
            return Number(value)
        }

        const seed = Math.random()
        searchParams.set('seed', seed.toString())
        window.history.replaceState({}, '', `?${searchParams.toString()}`)
        return seed
    }

    // two-color gradient across the canvas, mixed in srgb like the former shader
    function gradient(size: Size, angle: number, start: Color, end: Color): LinearGradient {
        return {
            ...gradientLine(size, angle),
            stops: [
                { offset: 0, color: start.to('srgb').toString({ format: 'hex' }) },
                { offset: 1, color: end.to('srgb').toString({ format: 'hex' }) },
            ],
        }
    }

    // point buffers, reused between frames
    let rows = new Float32Array(0)
    let columns = new Float32Array(0)
    let seed = 0

    initPlayground({
        setup() {
            seed = getSeed()
        },

        draw(target, { size, get, requestRender, exporting }) {
            onField = requestRender

            const noise: GridNoise = {
                xShapes: get<number>('x-shapes'),
                yShapes: get<number>('y-shapes'),
                noiseFreq: get<number>('noise-freq'),
                lacunarity: get<number>('lacunarity'),
                gain: get<number>('gain'),
                time: get<number>('time'),
                seed,
                octaves: get<number>('octaves'),
            }

            const scale = get<number>('scale')
            const xOffset = get<number>('x-offset') * size.w
            const yOffset = get<number>('y-offset') * size.h
            const xAmp = get<number>('x-amp') * size.w
            const yAmp = get<number>('y-amp') * size.h
            const xStrokeWidth = get<number>('x-stroke-width') * (size.w / 100)
            const yStrokeWidth = get<number>('y-stroke-width') * (size.w / 100)

            const grid = gradient(size, get<number>('grid-angle'), get<Color>('grid-start'), get<Color>('grid-end'))
            const background = gradient(size, get<number>('bg-angle'), get<Color>('bg-start'), get<Color>('bg-end'))

            target.rect(0, 0, size.w, size.h, { fill: background })

            const field = getField(noise, exporting)
            if (!field) {
                return
            }

            // warp the grid and scale it around the center
            const { xShapes, yShapes } = field.noise
            const { displacement } = field
            if (rows.length !== xShapes * yShapes * 2) {
                rows = new Float32Array(xShapes * yShapes * 2)
                columns = new Float32Array(xShapes * yShapes * 2)
            }

            const cx = size.w / 2
            const cy = size.h / 2
            for (let y = 0; y < yShapes; y++) {
                for (let x = 0; x < xShapes; x++) {
                    const k = (y * xShapes + x) * 2
                    const px = (xOffset + (x / xShapes) * size.w + displacement[k] * xAmp - cx) * scale + cx
                    const py = (yOffset + (y / yShapes) * size.h + displacement[k + 1] * yAmp - cy) * scale + cy

                    rows[k] = px
                    rows[k + 1] = py

                    const c = (x * yShapes + y) * 2
                    columns[c] = px
                    columns[c + 1] = py
                }
            }

            target.path(
                Array.from({ length: yShapes }, (_, y) => rows.subarray(y * xShapes * 2, (y + 1) * xShapes * 2)),
                false,
                { stroke: grid, strokeWidth: xStrokeWidth }
            )
            target.path(
                Array.from({ length: xShapes }, (_, x) => columns.subarray(x * yShapes * 2, (x + 1) * yShapes * 2)),
                false,
                { stroke: grid, strokeWidth: yStrokeWidth }
            )
        },
    })
</script>
